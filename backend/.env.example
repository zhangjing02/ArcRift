# =============================================================================
# Nowledge Mem / ArcRift Backend Environment Configuration / 后端环境配置
# =============================================================================

# Server Port / 服务端口
PORT=3001

# Storage Mode / 存储模式 (Pure SQLite 零依赖单文件数据库架构)
ARCRIFT_STORAGE_MODE=sqlite

# 数据与数据库存放目录 (默认自动存放在当前程序目录下的 ./data/ 文件夹内，可自定义如 D:/MyData)
# DATA_DIR=./data
# 或直接指定 SQLite 数据库文件绝对路径:
# SQLITE_DB_PATH=./data/NowledgeMem.db

# Log Level / 日志级别: debug | info | warn | error
LOG_LEVEL=info

# Context Mode / 上下文检索模式: "raw" (原始切片) | "summarized" (大模型实时精炼摘要)
CONTEXT_MODE=raw

# =============================================================================
# Cloud / Lightweight LLM & Embeddings API Configuration (No GPU Required)
# 云端 / 轻量化 API 配置（低配电脑/无独立显卡推荐，彻底解绑本地 Ollama 强依赖）
# =============================================================================

# -----------------------------------------------------------------------------
# Option 1: SiliconFlow / 硅基流动 (推荐: 国内超低延迟、高性价比、免费额度充裕)
# 支持 DeepSeek-V3 / DeepSeek-R1 及 BAAI BGE-M3 / BGE-Large 等高质量向量模型
# -----------------------------------------------------------------------------
# API_BASE_URL=https://api.siliconflow.cn/v1
# API_KEY=sk-your-siliconflow-key
# CHAT_MODEL=deepseek-ai/DeepSeek-V3
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-your-siliconflow-key
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# -----------------------------------------------------------------------------
# Option 2: DeepSeek Official / DeepSeek 官方接口
# -----------------------------------------------------------------------------
# API_BASE_URL=https://api.deepseek.com/v1
# API_KEY=sk-your-deepseek-key
# CHAT_MODEL=deepseek-chat
# (Embedding 可搭配硅基流动或 OpenAI)
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-your-siliconflow-key
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# -----------------------------------------------------------------------------
# Option 3: OpenAI Official / OpenAI 官方接口
# -----------------------------------------------------------------------------
# API_BASE_URL=https://api.openai.com/v1
# API_KEY=sk-your-openai-key
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-openai-key
# EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Option 4: Google Gemini
# -----------------------------------------------------------------------------
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# API_KEY=AIzaSyYourGeminiApiKey
# CHAT_MODEL=gemini-1.5-flash
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_KEY=AIzaSyYourGeminiApiKey
# EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Option 5: Groq Cloud (Free / Ultra Fast)
# -----------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Option 6: Local Ollama / 本地离线模式 (可选)
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
